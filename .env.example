# Copy to .env (next to docker-compose.yml) and set ORIGIN before starting.

# Exact URL you type in the browser to open the app: scheme, host and port.
# Writes coming from any other origin are rejected (403).
# Left empty on purpose: docker compose refuses to start until it is set.
# Examples:
#   ORIGIN=http://192.168.1.20:3005
#   ORIGIN=http://nas.local:3005
#   ORIGIN=https://cave.example.com
ORIGIN=
