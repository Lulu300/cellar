{
  "name": "cellar",
  "private": true,
  "version": "1.0.0-rc.2",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "paraglide-js compile --project ./project.inlang --silent && svelte-kit sync",
    "check": "paraglide-js compile --project ./project.inlang --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "paraglide-js compile --project ./project.inlang --silent && svelte-kit sync && pnpm run \"/^check:watch:/\"",
    "check:watch:messages": "paraglide-js compile --project ./project.inlang --silent --watch",
    "check:watch:types": "svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "i18n:check": "node scripts/check-i18n.mjs",
    "knip": "svelte-kit sync && knip",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "2.29.1",
    "@inlang/plugin-icu1": "^1.3.4",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.61.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/load-config": "^0.2.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/yauzl": "^3.4.0",
    "barcode-detector": "^3.2.3",
    "bits-ui": "^2.20.0",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "git-cliff": "^2.14.2",
    "globals": "^17.13.0",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "jspdf": "^4.2.1",
    "qrcode": "^1.5.4",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
